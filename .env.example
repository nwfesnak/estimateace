# =============================================================================
# ENVIRONMENT VARIABLE SEPARATION - IMPORTANT FOR PRODUCTION
# =============================================================================
# 1. Copy to .env.local for LOCAL DEVELOPMENT ONLY (never commit .env.local)
# 2. For Vercel: Add these in Vercel Dashboard → Project Settings → Environment Variables
#    - Use separate values for "Development", "Preview", and "Production" environments
#    - NEVER use the same Supabase project or API keys across environments
#
# Recommended setup:
# - Development: Local Supabase project or separate dev Supabase project
# - Preview: A staging Supabase project
# - Production: Your live Supabase project + production xAI key
# =============================================================================

# xAI / Grok API (server-only - never NEXT_PUBLIC_)
# IMPORTANT: In Vercel, when adding:
#   Key   = GROK_API_KEY     (type this exactly)
#   Value = the real long key from https://console.x.ai/
GROK_API_KEY=xai-your-actual-key-here-from-console.x.ai
# xAI model aliases — defaults use -latest so xAI rolls forward without code changes.
# Only set these if you need to pin a specific model version.
# GROK_MODEL=grok-4.5-latest
# GROK_CHAT_MODEL=grok-4.5-latest
# GROK_VISION_MODEL=grok-4.5-latest

# Supabase (public keys are safe to expose via NEXT_PUBLIC_ because RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# =============================================================================
# Phase A SaaS billing (EstimateAce product subscription — not client job payments)
# =============================================================================
# STRIPE_SECRET_KEY=sk_live_...       # LIVE real money (sk_test_ = test mode only)
# STRIPE_PRICE_ID=price_...          # LIVE recurring Price for SaaS (or monthly/yearly below)
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...    # LIVE webhook secret for /api/billing/webhook
# STRIPE_PASS_FEES_TO_CUSTOMER=true  # add card fee line on job Checkout (default true)
# NEXT_PUBLIC_BILLING_ENFORCE=false  # set true only after Stripe + webhook tested
# NEXT_PUBLIC_TRIAL_DAYS=14
# NEXT_PUBLIC_APP_URL=https://app.estimateace.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@estimateace.com
# SUPABASE_SERVICE_ROLE_KEY=         # required for trial seed + webhooks (server only)

# Platform owner (can upload Video Tutorials for all users)
# PLATFORM_ADMIN_EMAILS=you@estimateace.com
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=you@estimateace.com


# GROK_API_KEY powers AI quotes, descriptions, and translations.

# Optional: Google Places API Key (best address autocomplete when set)
# Free fallback uses OpenStreetMap Nominatim + US Census geocoder.
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Appointment notifications (server-only)
# Email via Resend: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_FROM_EMAIL=EstimateAce <notifications@yourdomain.com>

# SMS via Twilio: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# Public opt-in page / Twilio message-flow display number (must match sending number)
NEXT_PUBLIC_SMS_OPT_IN_NUMBER=+15551234567
NEXT_PUBLIC_APP_URL=https://app.estimateace.com

# Client approve/pay link HMAC (required in production)
CLIENT_ACTION_SECRET=generate_a_long_random_secret
# Optional alias used by login OTP
# OTP_PEPPER=generate_a_long_random_secret

# Platform tutorial admins (server-only, comma-separated — do NOT use NEXT_PUBLIC_)
# PLATFORM_ADMIN_EMAILS=you@estimateace.com

# Billing paywall (false/soft launch by default)
# NEXT_PUBLIC_BILLING_ENFORCE=false

# Appointment reminder cron (server-only, production)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=generate_a_long_random_secret_for_vercel_cron

# =============================================================================
# SECURITY NOTES BEFORE GOING LIVE
# - Use production Supabase project with strong RLS policies enabled
# - Run supabase/crew-members.sql (limited crew cannot DELETE)
# - Rotate keys regularly
# - Do NOT commit any .env* files that contain real secrets
# - Set CLIENT_ACTION_SECRET and CRON_SECRET in Vercel Production
# =============================================================================
